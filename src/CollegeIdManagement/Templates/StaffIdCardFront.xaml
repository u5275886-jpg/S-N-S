<UserControl x:Class="CollegeIdManagement.Templates.StaffIdCardFront"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="323" Height="204" Background="White">
    <Border BorderBrush="#1F2024" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1F2024" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Resources/Images/college-logo-placeholder.png" Height="38" Width="38" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding CollegeSettings.CollegeName, DefaultValue='SHYAM NANDAN SAHAY COLLEGE'}" Foreground="White" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="STAFF IDENTITY CARD" Foreground="#B89135" FontSize="8" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#1F2024" BorderThickness="1.5" CornerRadius="4" Width="72" Height="86" HorizontalAlignment="Left">
                    <Image Source="/Resources/Images/default-student.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="STAFF NAME" FontSize="12" FontWeight="Bold" Foreground="#1F2024" />
                    <TextBlock Text="Designation: Assistant Professor" FontSize="8" Margin="0,4,0,0" />
                    <TextBlock Text="Department: Faculty of Arts" FontSize="8" />
                    <TextBlock Text="Staff Code: STAFF/001" FontSize="8" FontWeight="Bold" Foreground="#751A38" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#751A38">
                <TextBlock Text="STAFF CARD" Foreground="White" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
