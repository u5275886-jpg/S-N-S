<Window x:Class="CollegeIdManagement.Views.Students.StudentFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration Form" Height="680" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F3F5">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0" Text="Student Details Form" FontSize="18" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" />

        <!-- Form Scroll Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- PERSONAL INFO -->
                <GroupBox Header="1. Personal Information" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="Student Name *" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="Father's Name" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.FatherName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                            <TextBlock Text="Mother's Name" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.MotherName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="Date of Birth" Style="{StaticResource FormLabel}" />
                            <DatePicker SelectedDate="{Binding Student.DateOfBirth}" Height="36" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="Gender" Style="{StaticResource FormLabel}" />
                            <ComboBox SelectedValue="{Binding Student.Gender}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Male" />
                                <ComboBoxItem Content="Female" />
                                <ComboBoxItem Content="Other" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                            <TextBlock Text="Blood Group" Style="{StaticResource FormLabel}" />
                            <ComboBox SelectedValue="{Binding Student.BloodGroup}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="A+" /><ComboBoxItem Content="A-" />
                                <ComboBoxItem Content="B+" /><ComboBoxItem Content="B-" />
                                <ComboBoxItem Content="O+" /><ComboBoxItem Content="O-" />
                                <ComboBoxItem Content="AB+" /><ComboBoxItem Content="AB-" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- ACADEMIC INFO -->
                <GroupBox Header="2. Academic Information" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="Member Code" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.MemberCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="Roll No" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.RollNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                            <TextBlock Text="Course" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Course, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="Session" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Session, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="Department" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                            <Button Content="Auto Generate Roll / Code" Command="{Binding AutoGenerateCodesCommand}" Style="{StaticResource OutlineButton}" Margin="0,22,0,0" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- CONTACT & ADDRESS -->
                <GroupBox Header="3. Contact &amp; Address" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="Mobile Number" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Mobile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="Email Address" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                            <TextBlock Text="Full Address" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Student.Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- MEDIA ATTACHMENTS -->
                <GroupBox Header="4. Photograph &amp; Signature" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Photo -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Student Photograph" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                            <Border BorderBrush="#751A38" BorderThickness="1.5" CornerRadius="4" Width="100" Height="120" Margin="0,5">
                                <Image Source="{Binding Student.PhotoPath, TargetNullValue='/Resources/Images/default-student.png'}" Stretch="UniformToFill" />
                            </Border>
                            <Button Content="Upload Photo" Command="{Binding UploadPhotoCommand}" Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                        </StackPanel>

                        <!-- Signature -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Student Signature" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                            <Border BorderBrush="#751A38" BorderThickness="1.5" CornerRadius="4" Width="180" Height="60" Margin="0,35,0,5">
                                <Image Source="{Binding Student.SignaturePath, TargetNullValue='/Resources/Images/default-signature.png'}" Stretch="Uniform" />
                            </Border>
                            <Button Content="Upload Signature" Command="{Binding UploadSignatureCommand}" Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="SAVE STUDENT RECORD" Command="{Binding SaveCommand}" Style="{StaticResource ModernButton}" Height="40" Padding="25,0" />
        </StackPanel>
    </Grid>
</Window>
