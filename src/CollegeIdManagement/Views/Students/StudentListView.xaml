<UserControl x:Class="CollegeIdManagement.Views.Students.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search & Action Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filters -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="180" Height="36" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Style="{StaticResource ModernComboBox}" Width="120" Height="36" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Course:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" Style="{StaticResource ModernComboBox}" Width="120" Height="36" />
                    </StackPanel>
                </WrapPanel>

                <!-- Top Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Import Excel" Command="{Binding ImportExcelCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                    <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                    <Button Content="+ Add Student" Command="{Binding AddStudentCommand}" Style="{StaticResource ModernButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Student DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Students}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Roll No" Binding="{Binding RollNo}" Width="80" />
                    <DataGridTextColumn Header="Member Code" Binding="{Binding MemberCode}" Width="150" />
                    <DataGridTextColumn Header="Student Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Father Name" Binding="{Binding FatherName}" Width="150" />
                    <DataGridTextColumn Header="Course" Binding="{Binding Course}" Width="80" />
                    <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="90" />
                    <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="110" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Command="{Binding DataContext.EditStudentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="10" Margin="0,0,4,0" />
                                    <Button Content="Delete" Command="{Binding DataContext.DeleteStudentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ModernButton}" Background="#C62828" Padding="8,4" FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
