<Window x:Class="CollegeIdManagement.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="College ID Management System - Login" Height="500" Width="750"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F6F3F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Brand Panel -->
        <Border Grid.Column="0" Background="#751A38" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resources/Images/app-logo.png" Height="90" Width="90" Margin="0,0,0,20" />
                <TextBlock Text="COLLEGE ID" Foreground="#B89135" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="MANAGEMENT SYSTEM" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="SHYAM NANDAN SAHAY COLLEGE" Foreground="#E2DCE0" FontSize="10" HorizontalAlignment="Center" Margin="0,15,0,0" TextAlignment="Center" />
                <TextBlock Text="MUZAFFARPUR, BIHAR" Foreground="#E2DCE0" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Right Form Panel -->
        <Border Grid.Column="1" Background="White" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sign In" FontSize="24" FontWeight="Bold" Foreground="#1F2024" />
                <TextBlock Text="Enter your credentials to access the system" FontSize="12" Foreground="#757575" Margin="0,4,0,25" />

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,16" />

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource FormLabel}" />
                <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,0,0,10" PasswordChanged="PasswordBox_PasswordChanged" />

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,0,0,15" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}, FallbackValue=Collapsed}" />

                <!-- Login Button -->
                <Button Content="LOGIN" Command="{Binding LoginCommand}" Style="{StaticResource ModernButton}" Height="42" FontSize="14" Margin="0,10,0,0" />

                <TextBlock Text="Demo Login: admin / admin123" FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,25,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
