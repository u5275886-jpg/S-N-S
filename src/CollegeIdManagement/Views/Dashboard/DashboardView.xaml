<UserControl x:Class="CollegeIdManagement.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Welcome Header -->
            <TextBlock Text="College Dashboard Overview" FontSize="20" FontWeight="Bold" Foreground="#1F2024" Margin="0,0,0,15" />

            <!-- Statistic Cards -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total Students" FontSize="11" Foreground="#757575" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#751A38" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Active Students" FontSize="11" Foreground="#757575" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveStudents}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Inactive Students" FontSize="11" Foreground="#757575" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InactiveStudents}" FontSize="24" FontWeight="Bold" Foreground="#C62828" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="IDs Generated" FontSize="11" Foreground="#757575" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IdsGenerated}" FontSize="24" FontWeight="Bold" Foreground="#B89135" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="IDs Pending" FontSize="11" Foreground="#757575" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IdsPending}" FontSize="24" FontWeight="Bold" Foreground="#E65100" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Action Buttons -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="+ Add / Manage Students" Command="{Binding NavigateStudentsCommand}" Style="{StaticResource ModernButton}" Margin="0,0,10,10" />
                        <Button Content="Generate ID Cards" Command="{Binding NavigateGenerateIdCommand}" Style="{StaticResource GoldButton}" Margin="0,0,10,10" />
                        <Button Content="Bulk ID Generation" Command="{Binding NavigateBulkIdCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" />
                        <Button Content="View Reports" Command="{Binding NavigateReportsCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Recent Students Table -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Recent Admissions" FontSize="14" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding RecentStudents}" AutoGenerateColumns="False" IsReadOnly="True" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Member Code" Binding="{Binding MemberCode}" Width="140" />
                            <DataGridTextColumn Header="Roll No" Binding="{Binding RollNo}" Width="80" />
                            <DataGridTextColumn Header="Student Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Course" Binding="{Binding Course}" Width="90" />
                            <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="100" />
                            <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="120" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
