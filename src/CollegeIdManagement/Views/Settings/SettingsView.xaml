<UserControl x:Class="CollegeIdManagement.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="College &amp; System Settings" FontSize="18" FontWeight="Bold" Foreground="#1F2024" Margin="0,0,0,15" />

            <!-- College Profile -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="College Profile Information" FontSize="14" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="College Full Name" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.CollegeName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="Short Name / Prefix" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.ShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="Affiliation Text" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.AffiliationText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="Address / Location" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                            <TextBlock Text="Phone Number" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                            <TextBlock Text="Email Address" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                            <TextBlock Text="ID Card Instructions (Back)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding Settings.IdCardInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Button Content="SAVE COLLEGE PROFILE" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ModernButton}" Height="38" HorizontalAlignment="Right" Margin="0,15,0,0" Padding="20,0" />
                </StackPanel>
            </Border>

            <!-- Backup & Restore -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Database Backup &amp; Restore" FontSize="14" FontWeight="Bold" Foreground="#751A38" Margin="0,0,0,15" />

                    <WrapPanel>
                        <Button Content="BACKUP DATABASE NOW" Command="{Binding BackupNowCommand}" Style="{StaticResource ModernButton}" Height="38" Margin="0,0,15,10" Padding="20,0" />
                        <Button Content="RESTORE FROM ZIP BACKUP" Command="{Binding RestoreBackupCommand}" Style="{StaticResource OutlineButton}" Height="38" Margin="0,0,15,10" Padding="20,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
