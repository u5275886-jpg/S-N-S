<Window x:Class="CollegeIdManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewsDash="clr-namespace:CollegeIdManagement.Views.Dashboard"
        xmlns:viewsStudents="clr-namespace:CollegeIdManagement.Views.Students"
        xmlns:viewsCards="clr-namespace:CollegeIdManagement.Views.IdCards"
        xmlns:viewsReports="clr-namespace:CollegeIdManagement.Views.Reports"
        xmlns:viewsSettings="clr-namespace:CollegeIdManagement.Views.Settings"
        xmlns:viewsUsers="clr-namespace:CollegeIdManagement.Views.Users"
        xmlns:vm="clr-namespace:CollegeIdManagement.ViewModels"
        Title="College ID Management System" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3F5">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <viewsDash:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentListViewModel}">
            <viewsStudents:StudentListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IdCardViewModel}">
            <viewsCards:IdCardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BulkIdCardViewModel}">
            <viewsCards:BulkIdCardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplateDesignerViewModel}">
            <viewsCards:TemplateDesignerPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <viewsReports:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <viewsSettings:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <viewsUsers:UserManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#1F2024">
            <DockPanel>
                <!-- College Branding Header -->
                <StackPanel DockPanel.Dock="Top" Padding="20,16" Background="#751A38">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Images/app-logo.png" Height="32" Width="32" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="COLLEGE ID" Foreground="#B89135" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="SYSTEM v1.0" Foreground="White" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,10">
                        <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SidebarButton}" />
                        <Button Content="Students" Command="{Binding NavigateCommand}" CommandParameter="Students" Style="{StaticResource SidebarButton}" />
                        <Button Content="ID Cards" Command="{Binding NavigateCommand}" CommandParameter="ID Cards" Style="{StaticResource SidebarButton}" />
                        <Button Content="Bulk Generator" Command="{Binding NavigateCommand}" CommandParameter="Bulk Generator" Style="{StaticResource SidebarButton}" />
                        <Button Content="Templates" Command="{Binding NavigateCommand}" CommandParameter="Templates" Style="{StaticResource SidebarButton}" />
                        <Button Content="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource SidebarButton}" />
                        <Button Content="College Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SidebarButton}" />
                        <Button Content="Users &amp; Roles" Command="{Binding NavigateCommand}" CommandParameter="Users" Style="{StaticResource SidebarButton}" />

                        <Separator Margin="8,15" Background="#33FFFFFF" />

                        <Button Content="Logout" Command="{Binding LogoutCommand}" Style="{StaticResource SidebarButton}" Foreground="#FF6B6B" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2DCE0" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CollegeName}" FontSize="15" FontWeight="Bold" Foreground="#751A38" VerticalAlignment="Center" />
                        <Border Background="#10751A38" CornerRadius="4" Padding="8,3" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveMenuName}" FontSize="12" FontWeight="SemiBold" Foreground="#751A38" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Logged in as: " FontSize="12" Foreground="#757575" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="Bold" Foreground="#1F2024" VerticalAlignment="Center" Margin="4,0,15,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DYNAMIC CONTENT VIEW -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20" />
        </Grid>
    </Grid>
</Window>
